# ==============================================================================                                                                                                                        
    # FleetPulse API & WebSocket Interactive Request Collection                                                                                                                                             
    # Compatible with VS Code REST Client & JetBrains HTTP Client                                                                                                                                           
    # ==============================================================================                                                                                                                        
                                                                                                                                                                                                            
    @baseUrl = http://localhost:4000                                                                                                                                                                        
    @wsUrl = ws://localhost:4000                                                                                                                                                                            
                                                                                                                                                                                                            
    # Set these variables after registering/authenticating a driver                                                                                                                                         
    @driverToken = YOUR_BEARER_TOKEN_HERE                                                                                                                                                                   
    @driverId = 1                                                                                                                                                                                           
    @orderId = 1                                                                                                                                                                                            
                                                                                                                                                                                                            
    # ==============================================================================                                                                                                                        
    # 1. DRIVER REST API ENDPOINTS                                                                                                                                                                          
    # ==============================================================================                                                                                                                        
                                                                                                                                                                                                            
    ### 1.1 Register a New Driver                                                                                                                                                                           
    # Registers a new driver with active: false (Pending Admin Approval)                                                                                                                                    
    POST {{baseUrl}}/driver/register                                                                                                                                                                        
    Content-Type: application/json                                                                                                                                                                          
                                                                                                                                                                                                            
    {                                                                                                                                                                                                       
      "name": "John Doe",                                                                                                                                                                                   
      "phone": "+628123456789",                                                                                                                                                                             
      "vehicle_plate": "B 1234 XYZ",                                                                                                                                                                        
      "capacity_kg": 500,                                                                                                                                                                                   
      "password": "PasswordSuperAman123!"                                                                                                                                                                   
    }                                                                                                                                                                                                       
                                                                                                                                                                                                            
    ### 1.2 Authenticate Driver & Issue Token                                                                                                                                                               
    # Mints a bearer token for socket connection. Refused if driver is active: false                                                                                                                        
    POST {{baseUrl}}/driver/session                                                                                                                                                                         
    Content-Type: application/json                                                                                                                                                                          
                                                                                                                                                                                                            
    {                                                                                                                                                                                                       
      "phone": "+628123456789",                                                                                                                                                                             
      "password": "PasswordSuperAman123!"                                                                                                                                                                   
    }                                                                                                                                                                                                       
                                                                                                                                                                                                            
                                                                                                                                                                                                            
    # ==============================================================================                                                                                                                        
    # 2. ADMIN AUTHENTICATION & DASHBOARD ENDPOINTS                                                                                                                                                         
    # ==============================================================================                                                                                                                        
                                                                                                                                                                                                            
    ### 2.1 Admin Login Page                                                                                                                                                                                
    GET {{baseUrl}}/admin/log_in                                                                                                                                                                            
                                                                                                                                                                                                            
    ### 2.2 Dispatch LiveView Dashboard (Requires Authenticated Admin Session)                                                                                                                              
    GET {{baseUrl}}/dispatch                                                                                                                                                                                
                                                                                                                                                                                                            
                                                                                                                                                                                                            
    # ==============================================================================                                                                                                                        
    # 3. PHOENIX CHANNEL WEBSOCKET TELMETRY & DISPATCH (DRIVER APP)                                                                                                                                         
    # Protocol: Phoenix Channels VSN 2.0.0                                                                                                                                                                  
    # Format: [join_ref, ref, topic, event, payload]                                                                                                                                                        
    # ==============================================================================                                                                                                                        
                                                                                                                                                                                                            
    ### 3.1 Connect & Join Driver WebSocket Topic                                                                                                                                                           
    # Connects to driver socket using bearer token and joins the driver channel                                                                                                                             
    WEBSOCKET {{wsUrl}}/socket/driver/websocket?vsn=2.0.0&token={{driverToken}}                                                                                                                             
    Content-Type: application/json                                                                                                                                                                          
                                                                                                                                                                                                            
    ===                                                                                                                                                                                                     
    # Frame 1: Join Topic "driver:<driver_id>"                                                                                                                                                              
    ["1", "1", "driver:{{driverId}}", "phx_join", {}]                                                                                                                                                       
                                                                                                                                                                                                            
    ===                                                                                                                                                                                                     
    # Frame 2: High-Frequency GPS Telemetry Ping (PRD 5.1 - Every 3-5s)                                                                                                                                     
    ["1", "2", "driver:{{driverId}}", "ping", {                                                                                                                                                             
      "latitude": -6.2088,                                                                                                                                                                                  
      "longitude": 106.8456,                                                                                                                                                                                
      "speed_kmh": 45.5,                                                                                                                                                                                    
      "bearing_deg": 180.0,                                                                                                                                                                                 
      "recorded_at": "2026-07-27T18:40:00Z"                                                                                                                                                                 
    }]                                                                                                                                                                                                      
                                                                                                                                                                                                            
    ===                                                                                                                                                                                                     
    # Frame 3: Update Driver Availability Status ("online" | "busy" | "offline")                                                                                                                            
    ["1", "3", "driver:{{driverId}}", "status", {                                                                                                                                                           
      "status": "online"                                                                                                                                                                                    
    }]                                                                                                                                                                                                      
                                                                                                                                                                                                            
    ===                                                                                                                                                                                                     
    # Frame 4: Mark Order Picked Up                                                                                                                                                                         
    ["1", "4", "driver:{{driverId}}", "pickup", {                                                                                                                                                           
      "order_id": {{orderId}}                                                                                                                                                                               
    }]                                                                                                                                                                                                      
                                                                                                                                                                                                            
    ===                                                                                                                                                                                                     
    # Frame 5: Mark Order Delivered (Frees driver back to online)                                                                                                                                           
    ["1", "5", "driver:{{driverId}}", "delivered", {                                                                                                                                                        
      "order_id": {{orderId}}                                                                                                                                                                               
    }]                                                                                                                                                                                                      
    ────── 