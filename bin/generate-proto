#!/usr/bin/env sh
# Generates the Elixir wire types from the contracts this service is pinned to.
#
# One list, two callers. The Dockerfile and CI both need exactly this, and until 2026-09-18 each
# carried its own copy of the protoc invocation — so adding payment/v1 to the image left CI
# compiling against a set that no longer matched, and the build died on an undefined Proto module.
# A list duplicated is a list that drifts.
#
# Run bin/sync-contracts first; this reads .contracts/proto and writes lib/fleet_pulse/proto, both
# of which are gitignored.
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

# The packages this service speaks. fleet and shipping it serves; payment it calls, to settle a
# courier's fee when a delivery lands; common carries the shared types the others import.
PACKAGES="common/v1/common fleet/v1/fleet shipping/v1/shipping payment/v1/payment"

INCLUDE="${PROTOC_INCLUDE:-}"
if [ -z "$INCLUDE" ]; then
  if command -v dpkg >/dev/null 2>&1; then
    INCLUDE="$(dpkg -L libprotobuf-dev 2>/dev/null | grep -m1 'timestamp.proto' | sed 's|/google/protobuf/timestamp.proto||')"
  elif command -v brew >/dev/null 2>&1; then
    INCLUDE="$(brew --prefix protobuf)/include"
  fi
fi
[ -n "$INCLUDE" ] || { echo "cannot locate protobuf's include directory; set PROTOC_INCLUDE"; exit 1; }

mkdir -p lib/fleet_pulse/proto

sources=""
for package in $PACKAGES; do
  source=".contracts/proto/$package.proto"
  [ -f "$source" ] || { echo "$source is missing; run bin/sync-contracts first"; exit 1; }
  sources="$sources $source"
done

# shellcheck disable=SC2086
protoc --elixir_out=plugins=grpc,package_prefix=fleet_pulse.proto:lib/fleet_pulse/proto \
  -I .contracts/proto -I "$INCLUDE" $sources

# Asserting each package, not merely that some .pb.ex exists. Three generated files are committed
# in this repository from before they were gitignored, so "a .pb.ex is present" is true even when
# protoc produced nothing at all — the check would pass while the build compiled against whatever
# happened to be checked in.
for package in $PACKAGES; do
  name="$(basename "$package")"
  find lib/fleet_pulse/proto -name "$name.pb.ex" | grep -q . || {
    echo "protoc produced no Elixir for $package"
    exit 1
  }
done

echo "generated: $PACKAGES"
