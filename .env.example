# Kinetix Matching Service — environment template
#
# Copy to .env and fill every value in. Values are intentionally blank where a wrong guess
# would be dangerous: the release refuses to start when a required one is missing
# (config/runtime.exs). Generate a secret with:  mix phx.gen.secret
# Never commit the filled-in .env, and never reuse a value across services.

# The release serves HTTP only when this is set.
PHX_SERVER=true
PORT=4000
# The public host of this endpoint's URL; a browser socket's Origin must match it. Required in production.
PHX_HOST=
GRPC_PORT=50053
# emergency alert critical error warning notice info debug; empty keeps the default.
LOG_LEVEL=info

DATABASE_URL=ecto://kinetix_matching_app:PASSWORD@localhost:5432/kinetix_matching_dev
POOL_SIZE=10
ECTO_IPV6=false
SECRET_KEY_BASE=

# Order's gRPC server (host:port), told of every delivery. Required.
ORDER_GRPC_HOST=
# The IANA zone the platform's day is counted in (warehouse reads the same). Required.
KINETIX_TIME_ZONE=Asia/Jakarta

# Identity's tokens: the JWKS to verify them and the claims they must carry. Required.
IDENTITY_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

# The mesh: this service's leaf, key and CA, and who may call which RPC
# (peer, peer@package.Service or peer@package.Service/Method, comma-separated).
KINETIX_PKI_DIR=/pki
KINETIX_TRUST_DOMAIN=
GRPC_ALLOWED_CALLERS=

# The proof-of-delivery store (any S3 that keeps a SHA-256 checksum). Required in production.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_PUBLIC_URL=
OBJECT_STORE_POD_BUCKET=kinetix-pod
OBJECT_STORE_REGION=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# Clustering, only when several nodes run.
DNS_CLUSTER_QUERY=
